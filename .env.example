# BedrockOps runtime configuration — copy to .env or export in shell.
# No secrets belong in this file. AWS credentials must come from your
# own AWS CLI / SSO / environment at run time, never from chat or git.

# Set to 1 to make system_probe perform real read-only AWS calls.
# Default (unset): stub telemetry, honestly labeled mode="stub".
BEDROCKOPS_LIVE=

# DynamoDB audit table name (from `terraform output audit_ledger_table_name`).
# Unset: audit_ledger keeps events in memory and reports persisted=false.
AUDIT_TABLE_NAME=

AWS_REGION=us-east-1

# Model for the Bedrock call (bedrock_agent reads BEDROCK_MODEL_ID;
# this value wins over the code default). Default below is the primary
# target, Anthropic Claude Sonnet 5. Note: on a NEW AWS account,
# Anthropic models refuse invocation ("not available for this
# account") until the one-time use-case-details form is approved.
# Until that gate opens, these Amazon models are normally available
# immediately on a new account and run through the exact same code
# path (the invoke uses the provider-agnostic Converse API):
#   BEDROCK_MODEL_ID=amazon.nova-lite-v1:0   # fast, cheapest fallback
#   BEDROCK_MODEL_ID=amazon.nova-pro-v1:0    # stronger fallback
# Switch back to the Claude default once Anthropic approves the
# account. Nothing else in the code changes either way.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
