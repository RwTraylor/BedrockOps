# BedrockOps runtime configuration — copy to .env or export in shell.
# No secrets belong in this file. AWS credentials must come from your
# own AWS CLI / SSO / environment at run time, never from chat or git.

# Set to 1 to make system_probe perform real read-only AWS calls.
# Default (unset): stub telemetry, honestly labeled mode="stub".
BEDROCKOPS_LIVE=

# DynamoDB audit table name (from `terraform output audit_ledger_table_name`).
# Unset: audit_ledger keeps events in memory and reports persisted=false.
AUDIT_TABLE_NAME=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
